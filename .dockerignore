# Keep the build context small. Without this, `docker build .` uploads the whole
# `target/` tree — gigabytes — before the first instruction runs.

/target
/site
/data
/packages
/.git
/.github
/tests
/scripts

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-*
yanuget.local.toml
appsettings.local.json

# Secrets never go into the build context: a stray `COPY . .` would bake them
# into an image layer, and the context is sent to whatever builder is in use.
# Same list as .gitignore; `**/` because a bare pattern here only matches at
# the root of the context.
yanuget.toml
**/secrets.env
**/*.env
**/*.pem
**/*.key

.DS_Store
.idea/
.vscode/
*.swp
